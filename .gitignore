# Dependencies — huge, fully regenerated by `npm install`
node_modules/

# Build output — regenerated by `npm run build`
dist/

# Environment/secrets — this project doesn't currently use any, but
# keeping this is cheap insurance if that ever changes
.env
.env.local
.env*.local

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor folders — personal to whoever's machine, not project config
.vscode/
.idea/

# TypeScript incremental build cache, if ever enabled
*.tsbuildinfo

# Future test coverage output (once the planned Vitest suite exists)
coverage/

# MediaPipe model binary — ~3.7MB, auto-downloaded by the postinstall
# script (scripts/download-mediapipe-model.js) on every `npm install`,
# including as part of the host's build step. Committing this would be
# harmless in terms of correctness, but it's exactly the kind of binary
# that doesn't belong in git history — regenerating it is free and fast.
public/models/*.task
